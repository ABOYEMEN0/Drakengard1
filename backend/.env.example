# LEOR backend environment
NODE_ENV=development
PORT=4000

# PostgreSQL
DATABASE_URL=postgresql://leor:leor@localhost:5432/leor?schema=public

# Redis (caching, rate limiting)
REDIS_URL=redis://localhost:6379

# JWT
JWT_ACCESS_SECRET=change-me-access
JWT_REFRESH_SECRET=change-me-refresh
JWT_ACCESS_TTL=900s
JWT_REFRESH_TTL=30d

# CORS
FRONTEND_ORIGIN=http://localhost:3000

# S3-compatible storage (Cloudflare R2 / MinIO / S3)
S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET=leor-assets
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# Store
STORE_WHATSAPP=966500000000
